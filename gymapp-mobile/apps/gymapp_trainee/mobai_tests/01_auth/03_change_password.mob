# Trainee change-password — exercise POST /identity/change-password.
# Requires the user to already be logged in (run 02_login_param.mob first).
# Params: ${currentPassword} ${newPassword}
# Tags: auth, change-password, preprod
# Timeout: 60000

# Navigate to More → Settings → Change Password
tap ~"المزيد"
wait_for ~"الاعدادات" timeout:5000
tap ~"الاعدادات" on_fail:skip
tap ~"الإعدادات" on_fail:skip
delay 1500

# The settings screen lists "كلمة المرور" / "تغيير كلمة المرور" — match either.
tap "تغيير كلمة المرور" on_fail:skip
tap ~"كلمة المرور" on_fail:skip
wait_for ~"كلمة المرور الحالية" timeout:8000

type ~"كلمة المرور الحالية" → "${currentPassword}"
delay 400
hide_keyboard on_fail:skip
type ~"كلمة المرور الجديدة" → "${newPassword}"
delay 400
hide_keyboard on_fail:skip
type ~"تأكيد" → "${newPassword}" on_fail:skip
delay 400
hide_keyboard on_fail:skip

tap ~"حفظ" type:button on_fail:skip
tap ~"تغيير" type:button on_fail:skip
tap ~"تأكيد" type:button on_fail:skip
delay 2500

# Either a success toast or a returned-to-settings state is OK; what's NOT OK
# is an unhandled exception or "invalid credentials" banner.
assert_not_exists ~"ApiException"
assert_not_exists ~"500 Internal"
assert_not_exists ~"بيانات تسجيل الدخول غير صحيحة"
