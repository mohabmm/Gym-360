# Kiosk PIN screen loads and shows correct permission error for Receptionist role
# Tags: settings, permissions
# Timeout: 20000

# Reset to known state
hide_keyboard on_fail:skip
tap ~"رجوع" on_fail:skip
tap ~"رجوع" on_fail:skip
tap ~"الرئيسية"
wait_for ~"الاعضاء النشطين" timeout:8000

tap ~"المزيد"
wait_for "الاعدادات" timeout:4000
tap "الاعدادات"
wait_for ~"رقم PIN الكيوسك" timeout:4000
tap ~"رقم PIN الكيوسك"
wait_for ~"PIN جديد" timeout:5000

assert_exists ~"PIN جديد"
# PIN set or not-set status card must be present
assert_not_exists ~"خطأ في التحميل"

# Attempt to save with PIN fields filled (validation / permission check)
type ~"PIN جديد" → "1234"
type ~"تأكيد PIN" → "1234"
hide_keyboard on_fail:skip
tap ~"حفظ" type:button
delay 3000

# Receptionist gets permission denied (not generic "Something went wrong")
# Either shows permission error or validation error — must NOT show raw ApiException
assert_not_exists ~"ApiException"
assert_not_exists ~"Something went wrong"

tap ~"رجوع"
tap ~"رجوع" on_fail:skip
