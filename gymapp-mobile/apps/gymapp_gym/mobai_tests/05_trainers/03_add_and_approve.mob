# Owner adds a trainer + auto-approves (POST /identity/users/staff-create-trainer
# + POST /gyms/{id}/trainers/{tid}/approve).
# Params: ${email} ${phone} ${firstName} ${lastName}
# Tags: trainers, write, preprod
# Timeout: 60000

tap ~"المزيد"
delay 1500
tap "المدربين" on_fail:skip
tap "مدربون" on_fail:skip
delay 2500

tap ~"إضافة" type:button on_fail:skip
delay 1500

type ~"البريد" → "${email}"
delay 400
hide_keyboard on_fail:skip
type ~"الاسم الأول" → "${firstName}" on_fail:skip
delay 400
hide_keyboard on_fail:skip
type ~"اسم العائلة" → "${lastName}" on_fail:skip
delay 400
hide_keyboard on_fail:skip
type ~"الهاتف" → "${phone}" on_fail:skip
delay 400
hide_keyboard on_fail:skip

tap ~"حفظ" type:button on_fail:skip
tap ~"إضافة" type:button on_fail:skip
delay 3000

assert_not_exists ~"ApiException"
assert_not_exists ~"500 Internal"
