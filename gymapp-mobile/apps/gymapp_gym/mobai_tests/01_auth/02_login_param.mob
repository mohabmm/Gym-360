# Staff/owner login parameterised — accepts ${email} ${password} so the same
# script drives any loop's freshly-bootstrapped owner/staff account.
# Tags: auth, smoke, tenancy, preprod
# Timeout: 90000

# Logout cascade if already in.
tap ~"المزيد" on_fail:skip
delay 1000
tap ~"الإعدادات" on_fail:skip
delay 1000
tap ~"الاعدادات" on_fail:skip
delay 1000
tap ~"تسجيل الخروج" on_fail:skip
delay 1500
tap ~"خروج" on_fail:skip
delay 2000
tap ~"تأكيد" on_fail:skip
delay 2000

wait_for ~"البريد" timeout:15000

type ~"أدخل بريدك" → "${email}" on_fail:skip
delay 600
hide_keyboard on_fail:skip
delay 400
type ~"أدخل كلمة المرور" → "${password}"
delay 600
hide_keyboard on_fail:skip
delay 400
tap ~"تسجيل الدخول" type:button

wait_for ~"الاعضاء النشطين" timeout:30000

assert_not_exists ~"ApiException"
assert_not_exists ~"Invalid object name"
assert_not_exists ~"500 Internal"
