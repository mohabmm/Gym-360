# Staff quick-assigns a session package to a member (POST /billing/packages/
# quick-assign). Confirms the assign flow doesn't 500 and the new package
# shows in the active list afterwards.
# Tags: billing, write, preprod
# Timeout: 60000

# Reset to known state — bottom-half tap to reach the Members tab on the
# bottom-nav bar.
tap ~"الاعضاء" bounds:bottom_half
delay 2000

# Open first member detail
delay 2500

tap ~"تعيين باقة" on_fail:skip
tap ~"تعيين مدرب" on_fail:skip
tap ~"باقات" on_fail:skip
delay 2000

# Pick first trainer + first template / count 4
tap ~"اختر المدرب" on_fail:skip
delay 1500
delay 1000

tap "4" on_fail:skip
delay 800

tap ~"تعيين" type:button on_fail:skip
tap ~"حفظ" type:button on_fail:skip
delay 3000

assert_not_exists ~"ApiException"
assert_not_exists ~"500 Internal"
