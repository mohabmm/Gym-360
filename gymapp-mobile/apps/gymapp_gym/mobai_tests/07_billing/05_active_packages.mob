# Active packages list loads without error
# Tags: billing, smoke
# Timeout: 15000

# Reset to known state
hide_keyboard on_fail:skip
tap ~"رجوع" on_fail:skip
tap ~"رجوع" on_fail:skip
tap ~"الرئيسية"
wait_for ~"الاعضاء النشطين" timeout:8000

tap ~"المزيد"
wait_for "الباقات النشطة" timeout:4000
tap "الباقات النشطة"
wait_for ~"الباقات" timeout:8000

assert_not_exists ~"خطأ"

tap ~"رجوع"
