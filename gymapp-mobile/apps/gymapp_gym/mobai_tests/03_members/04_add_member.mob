# Staff/owner creates a brand-new member via POST /identity/users/staff-create.
# Params: ${email} ${phone} ${firstName} ${lastName}
# Tags: members, write, preprod
# Timeout: 60000

tap ~"الاعضاء" bounds:bottom_half
wait_for "الكل" type:button timeout:5000

# Add-member FAB lives bottom-right on the members list (owner/manager perm).
tap ~"إضافة عضو" type:button on_fail:skip
tap ~"عضو جديد" type:button on_fail:skip
tap ~"إضافة" type:button on_fail:skip
delay 1500

type ~"البريد" → "${email}"
delay 400
hide_keyboard on_fail:skip
type ~"الاسم الأول" → "${firstName}" on_fail:skip
delay 400
hide_keyboard on_fail:skip
type ~"اسم العائلة" → "${lastName}" on_fail:skip
delay 400
hide_keyboard on_fail:skip
type ~"الهاتف" → "${phone}" on_fail:skip
delay 400
hide_keyboard on_fail:skip

tap ~"حفظ" type:button on_fail:skip
tap ~"إضافة" type:button on_fail:skip
tap ~"تأكيد" type:button on_fail:skip
delay 3500

assert_not_exists ~"ApiException"
assert_not_exists ~"500 Internal"
