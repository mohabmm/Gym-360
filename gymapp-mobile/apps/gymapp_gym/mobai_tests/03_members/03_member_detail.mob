# Open first member in list and verify profile screen
# Tags: members, smoke
# Timeout: 15000

tap ~"الاعضاء" bounds:bottom_half
wait_for "الكل" type:button timeout:5000

# Tap first member row (StaticText rows in Flutter list)
tap ~"Demo Trainee"
wait_for ~"ملف العضو" timeout:5000

# Member profile loaded
assert_exists ~"ملف العضو"
assert_not_exists ~"خطأ في تحميل الملف"

# Go back
tap ~"رجوع"
wait_for ~"الاعضاء" timeout:3000
