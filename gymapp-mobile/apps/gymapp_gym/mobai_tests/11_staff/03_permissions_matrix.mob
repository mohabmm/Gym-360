# Permission matrix screen opens from staff list app bar
# Tags: staff, smoke
# Timeout: 15000

# Reset to known state
hide_keyboard on_fail:skip
tap ~"رجوع" on_fail:skip
tap ~"رجوع" on_fail:skip
tap ~"الرئيسية"
wait_for ~"الاعضاء النشطين" timeout:8000

tap ~"المزيد"
wait_for "الموظفين" timeout:4000
tap "الموظفين"
wait_for ~"الموظفون" timeout:5000

tap ~"صلاحيات" type:button
wait_for ~"مصفوفة الصلاحيات" timeout:5000

assert_exists ~"مصفوفة الصلاحيات"
assert_exists ~"الصلاحية"

tap ~"رجوع"
tap ~"رجوع" on_fail:skip
