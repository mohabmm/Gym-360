{
  "name": "gymapp-web",
  "private": true,
  "workspaces": [
    "packages/@gymapp/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "type-check": "turbo type-check",
    "clean": "turbo clean",
    "dev:admin": "turbo dev --filter=admin",
    "dev:gym-staff": "turbo dev --filter=gym-staff",
    "build:admin": "turbo build --filter=admin",
    "build:gym-staff": "turbo build --filter=gym-staff"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "turbo": "^2.0.0",
    "typescript": "^5.4.0"
  },
  "packageManager": "npm@10.5.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "sonner": "^2.0.7"
  }
}
