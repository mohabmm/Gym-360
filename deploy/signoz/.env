# SigNoz pinned versions (latest stable as of 2026-05-30).
# Bump these to upgrade; re-run scripts/deploy_signoz.sh.
#
# SIGNOZ_TAG drives BOTH the deploy/docker tree that is fetched (so compose +
# its clickhouse/otel config files stay internally consistent) AND the
# signoz app image (VERSION). OTELCOL_TAG is left to the release's own matched
# default unless you have a specific reason to override it.
SIGNOZ_TAG=v0.126.1

# The signoz app image tag (VERSION env consumed by the compose). Keep == SIGNOZ_TAG.
VERSION=v0.126.1

# OTLP receiver the .NET API ships to (internal Docker network, OTLP/HTTP).
# Mirror these on the Dokploy API app's Environment:
#   OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4318
#   OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
#   OTEL_SERVICE_NAME=gymapp-api
