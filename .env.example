# .env.example — committed to Git as template
# Copy this to .env (gitignored) for local dev. Real secrets never commit.
# Consumed by docker-compose.yml via ${VAR:-default} substitution.

# ─── Runtime ──────────────────────────────────────────────────
ASPNETCORE_ENVIRONMENT=Development

# ─── SQL Server 2022 ──────────────────────────────────────────
# SA password — must satisfy MSSQL complexity (8+ chars, upper+lower+digit+symbol)
DB_SA_PASSWORD=CHANGE_ME_StrongP@ssw0rd!

# ─── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_redis_local

# ─── RabbitMQ ─────────────────────────────────────────────────
RABBITMQ_DEFAULT_USER=gymapp
RABBITMQ_DEFAULT_PASS=CHANGE_ME_rabbit_local

# ─── JWT ──────────────────────────────────────────────────────
# Generate: openssl rand -base64 64    (min 32 chars enforced)
JWT_SECRET_KEY=CHANGE_ME_USE_LONG_RANDOM_STRING_MIN_32_CHARS

# ─── CORS allowed origins ─────────────────────────────────────
CORS_ORIGIN_0=http://localhost:3000
CORS_ORIGIN_1=http://localhost:3001
CORS_ORIGIN_2=http://localhost:3003

# ─── FCM (Firebase Cloud Messaging) ───────────────────────────
# Service-account JSON mounted at /run/secrets/firebase-service-account.json
# Place real file at ./config/firebase-service-account.json (gitignored)
FCM_ENABLED=true
FCM_PROJECT_ID=forma-389d6

# ─── Multi-tenancy ────────────────────────────────────────────
# Hard = per-gym schema isolation (production posture)
TENANCY_MODE=Hard
# Run EF migrations + fresh-DB self-bootstrap at startup. Keep true for
# Dokploy/staging (non-Development env) so deploys self-provision the DB.
# Idempotent; refuses to auto-stamp a DB that already holds soft-tenancy data.
DB_AUTO_MIGRATE=true

# ─── Seeders (DEV ONLY — keep false in production) ────────────
TENANCY_RUN_DEV_SEEDERS_ON_HARD=false
SEED_RUN_DEMO_DATA=false
IDENTITY_RUN_DEV_SEEDER=true
IDENTITY_DEV_SEEDER_SCOPE=admin

# ─── OpenTelemetry → SigNoz ───────────────────────────────────
# Pending wire-up in API (OpenTelemetry SDK + OTLP exporter). Until then
# these vars are no-ops; uncomment once Program.cs registers OTel.
OTEL_SERVICE_NAME=gymapp-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://signoz-otel-collector:4317
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_RESOURCE_ATTRIBUTES=deployment.environment=local,service.namespace=gymapp
# Self-hosted SigNoz access key (leave blank for unauthenticated local)
# OTEL_EXPORTER_OTLP_HEADERS=signoz-access-token=CHANGE_ME
