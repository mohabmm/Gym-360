{
  "_COMMENT": "Production-safe defaults. Secrets MUST be supplied via environment variables or user-secrets. See appsettings.Development.json for local dev values.",
  "ConnectionStrings": {
    "Database": "REPLACE_VIA_ENV",
    "Redis": "REPLACE_VIA_ENV"
  },
  "Jwt": {
    "Issuer": "GymApp",
    "Audience": "GymApp",
    "SecretKey": "REPLACE_VIA_ENV",
    "AccessTokenExpirationMinutes": 60,
    "RefreshTokenExpirationDays": 30
  },
  "Outbox": {
    "IntervalInSeconds": 10,
    "BatchSize": 20
  },
  "Otp": {
    "Provider": "Log",
    "Smtp": {
      "Host": "smtp.gmail.com",
      "Port": 587,
      "UseSsl": true,
      "Username": "",
      "Password": "",
      "From": "noreply@gymapp.com",
      "FromName": "GymApp"
    }
  },
  "Fcm": {
    "ProjectId": "REPLACE_VIA_ENV",
    "ServiceAccountKeyPath": "REPLACE_VIA_ENV",
    "IsEnabled": false
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.Seq"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      { "Name": "Seq", "Args": { "serverUrl": "http://localhost:5341" } }
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  }
}
